# Automatically provided by Supabase in deployed Edge Functions:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# RevenueCat webhook: configure the exact Authorization header value in both RevenueCat and this secret.
REVENUECAT_WEBHOOK_AUTH=Bearer replace-with-long-random-secret
REVENUECAT_PREMIUM_ENTITLEMENT=premium

# Provider-agnostic OpenAI-compatible chat-completions endpoint.
AI_CHAT_COMPLETIONS_URL=https://provider.example/v1/chat/completions
AI_API_KEY=replace-me
AI_MODEL=replace-me

# Optional cost telemetry, USD price per 1M tokens.
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
